# Configuration pour l'envoi d'emails via Resend
# Obtenir votre clé API sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domaine vérifié pour l'envoi d'emails (optionnel)
# Si vous n'avez pas de domaine vérifié, utilisez le domaine sandbox de Resend
EMAIL_FROM_DOMAIN=aurelienmazel.com

# Email de réponse par défaut
REPLY_TO_EMAIL=mazel.aurelien@hotmail.com
